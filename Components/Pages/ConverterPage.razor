@page "/converter"
@page "/converter/{Id:int}"
@using UnitConverter.Models
@inject DatabaseService DbService
@inject NavigationManager Navigation

<PageTitle>@(Id.HasValue ? "Edit Conversion" : "Add Conversion")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@(Id.HasValue ? "Edit Conversion" : "Unit Converter")</MudText>

    <MudSelect T="string" Label="Category" @bind-Value="SelectedCategory" @bind-Value:after="OnCategoryChanged">
        <MudSelectItem Value="@("Length")">Length</MudSelectItem>
        <MudSelectItem Value="@("Weight")">Weight</MudSelectItem>
        <MudSelectItem Value="@("Temperature")">Temperature</MudSelectItem>
    </MudSelect>

    <MudGrid Class="mt-2">
        <MudItem xs="6">
            <MudSelect T="string" Label="From" @bind-Value="FromUnit" @bind-Value:after="Convert">
                @foreach (var unit in CurrentUnits)
                {
                    <MudSelectItem Value="@unit">@unit</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6">
            <MudSelect T="string" Label="To" @bind-Value="ToUnit" @bind-Value:after="Convert">
                @foreach (var unit in CurrentUnits)
                {
                    <MudSelectItem Value="@unit">@unit</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudNumericField T="double" Label="Value" @bind-Value="InputValue" @bind-Value:after="Convert" Class="mt-4" />

    <MudText Typo="Typo.h5" Class="mt-4">Result: @Result.ToString("0.####")</MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveConversion">
        @(Id.HasValue ? "Update" : "Save")
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-4 ml-2" OnClick="GoToHistory">
back
</MudButton>
    </MudContainer>

@code {
    [Parameter]
    public int? Id { get; set; }

    private string SelectedCategory = "Length";
    private string FromUnit = "Meter";
    private string ToUnit = "Kilometer";
    private double InputValue = 0;
    private double Result = 0;
    private int? EditingRecordId = null;

    private Dictionary<string, string[]> CategoryUnits = new()
    {
        { "Length", new[] { "Meter", "Kilometer", "Centimeter", "Mile", "Foot", "Inch" } },
        { "Weight", new[] { "Kilogram", "Gram", "Pound", "Ounce" } },
        { "Temperature", new[] { "Celsius", "Fahrenheit", "Kelvin" } }
    };

    private string[] CurrentUnits => CategoryUnits[SelectedCategory];

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await DbService.GetConversionByIdAsync(Id.Value);
            if (existing != null)
            {
                EditingRecordId = existing.Id;
                FromUnit = existing.FromUnit;
                ToUnit = existing.ToUnit;
                InputValue = existing.InputValue;

                SelectedCategory = CategoryUnits.FirstOrDefault(kv => kv.Value.Contains(existing.FromUnit)).Key ?? "Length";

                Convert();
            }
        }
    }

    private void OnCategoryChanged()
    {
        FromUnit = CurrentUnits[0];
        ToUnit = CurrentUnits.Length > 1 ? CurrentUnits[1] : CurrentUnits[0];
        Convert();
    }

    private void Convert()
    {
        Result = ConvertValue(SelectedCategory, FromUnit, ToUnit, InputValue);
    }

    private async Task SaveConversion()
    {
        Convert();

        var record = new Conversion
        {
            Id = EditingRecordId ?? 0,
            FromUnit = FromUnit,
            ToUnit = ToUnit,
            InputValue = InputValue,
            ResultValue = Result,
            ConvertedAt = DateTime.Now
        };

        if (EditingRecordId.HasValue)
        {
        record.WasUpdated = true;
        
            await DbService.UpdateConversionAsync(record);
        }
        else
        {
            await DbService.SaveConversionAsync(record);
        }

        Navigation.NavigateTo("/history");
    }

    private void GoToHistory()
    {
        Navigation.NavigateTo("/history");
    }

    private double ConvertValue(string category, string from, string to, double value)
    {
        if (from == to) return value;

        double meters = category switch
        {
            "Length" => from switch
            {
                "Meter" => value,
                "Kilometer" => value * 1000,
                "Centimeter" => value / 100,
                "Mile" => value * 1609.34,
                "Foot" => value * 0.3048,
                "Inch" => value * 0.0254,
                _ => value
            },
            "Weight" => from switch
            {
                "Kilogram" => value,
                "Gram" => value / 1000,
                "Pound" => value * 0.453592,
                "Ounce" => value * 0.0283495,
                _ => value
            },
            _ => value
        };

        if (category == "Temperature")
        {
            double celsius = from switch
            {
                "Celsius" => value,
                "Fahrenheit" => (value - 32) * 5.0 / 9.0,
                "Kelvin" => value - 273.15,
                _ => value
            };

            return to switch
            {
                "Celsius" => celsius,
                "Fahrenheit" => (celsius * 9.0 / 5.0) + 32,
                "Kelvin" => celsius + 273.15,
                _ => celsius
            };
        }

        return category switch
        {
            "Length" => to switch
            {
                "Meter" => meters,
                "Kilometer" => meters / 1000,
                "Centimeter" => meters * 100,
                "Mile" => meters / 1609.34,
                "Foot" => meters / 0.3048,
                "Inch" => meters / 0.0254,
                _ => meters
            },
            "Weight" => to switch
            {
                "Kilogram" => meters,
                "Gram" => meters * 1000,
                "Pound" => meters / 0.453592,
                "Ounce" => meters / 0.0283495,
                _ => meters
            },
            _ => meters
        };
    }
}